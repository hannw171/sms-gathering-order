# ==============================================================================
# SMS GATHERING & ORDER NIGHT 2026 - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env pada server hosting / cPanel produksi:
# cp .env.production.example .env

APP_NAME="SMS Gathering & Order Night"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gathering.pbfsehatmedika.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# DATABASE PRODUCTION (MySQL / MariaDB cPanel atau Cloud DB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pbf_gathering_order
DB_USERNAME=pbf_user
DB_PASSWORD=secret_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
